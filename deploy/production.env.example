PUBLIC_HOST=arena.example.com
DB_USER=arenaverse
DB_PASSWORD=replace-with-a-url-safe-database-password
DB_NAME=arenaverse
DB_PORT=5432

JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_RESET_SECRET=replace-with-a-third-long-random-secret
METRICS_TOKEN=replace-with-a-long-random-metrics-token

MINIO_ROOT_USER=arenaverse-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_APP_PASSWORD=replace-with-an-app-password
EMAIL_FROM=ArenaVerse <mailer@example.com>

TLS_CERT_FILE=./deploy/certs/fullchain.pem
TLS_KEY_FILE=./deploy/certs/privkey.pem
