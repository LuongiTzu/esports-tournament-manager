DATABASE_URL="postgresql://user:password@localhost:5432/esports_tournament_manager?schema=public"
# Required only when RUN_DATABASE_E2E=true. Keep E2E data isolated from development data.
E2E_DATABASE_URL="postgresql://user:password@localhost:5432/esports_tournament_manager_e2e?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_RESET_SECRET="legacy-only-not-used-for-email-reset-tokens"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_MAX_AGE_MS=604800000

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-account@gmail.com"
SMTP_APP_PASSWORD="your-gmail-app-password"
EMAIL_FROM="ArenaVerse <your-account@gmail.com>"

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_GLOBAL=100

# local (default) or s3. S3 settings also work with MinIO.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="arenaverse"
S3_ACCESS_KEY_ID="minio-access-key"
S3_SECRET_ACCESS_KEY="minio-secret-key"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/arenaverse"

# When set, GET /api/metrics requires Authorization: Bearer <token>.
METRICS_TOKEN=""
